[ignore]
.*next\.config\.js.*
.*invalidPackageJson/package.json
.*/node_modules/.*/examples/.*
.*/node_modules/.staging/.*
.*/node_modules/.*/test/.*
.*/node_modules/.*/__tests__/.*
.*/node_modules/fbjs/.*
.*/node_modules/graphql/.*
.*/node_modules/graphql-tag/.*

[include]

[libs]
flow/interfaces/
flow/flow-typed/

[options]
module.system=node
suppress_type=$FlowIssue
esproposal.class_static_fields=ignore
esproposal.class_instance_fields=enable
types_first=true
sharedmemory.hash_table_pow=21
module.name_mapper='.*\.\(jpe\?g\|png\|gif\|svg\)$' -> '<PROJECT_ROOT>/flow/stubs/image.js'
module.name_mapper='.*\.\(css\|s[ac]ss\)$' -> '<PROJECT_ROOT>/flow/stubs/css.js'
# App code has been converted to TypeScript which Flow can't read so map any
# imports of it to an untyped stub
module.name_mapper='^\(\.\./\)+\(src\|fixtures\|components\|hooks\|contexts\|helpers\|pages\|queries\|types\)/.*' -> '<PROJECT_ROOT>/flow/stubs/typescript-module.js'
module.name_mapper='^@/\(src\|fixtures\|components\|hooks\|contexts\|helpers\|pages\|queries\|types\)/.*' -> '<PROJECT_ROOT>/flow/stubs/typescript-module.js'
module.name_mapper='^@/\(.*\)' -> '<PROJECT_ROOT>/\1'

[version]
0.133.0
