{
  "presets": [
    [
      "next/babel",
      {
        "preset-env": {
          "targets": {
            "browsers": "> 0.25%, not dead, not op_mini all, not op_mob >= 1"
          },
          "bugfixes": true,
          "useBuiltIns": "usage",
          "corejs": 3.22
        },
        "preset-typescript": {
          "onlyRemoveTypeImports": true
        }
      }
    ],
    "@babel/preset-react"
  ],
  "plugins": [
    [
      "module-resolver",
      {
        "alias": {
          "@": "."
        },
        "extensions": [
          ".js",
          ".jsx",
          ".ts",
          ".tsx",
          ".json"
        ]
      }
    ]
  ],
  "overrides": [
    {
      "test": [
        "**/*.js",
        "**/*.jsx"
      ],
      "presets": [
        "@babel/preset-flow"
      ]
    },
    {
      "test": [
        "**/*.ts"
      ],
      "plugins": [
        [
          "@babel/plugin-transform-typescript",
          {
            "onlyRemoveTypeImports": true,
            "allowNamespaces": true
          }
        ]
      ]
    },
    {
      "test": [
        "**/*.tsx"
      ],
      "plugins": [
        [
          "@babel/plugin-transform-typescript",
          {
            "onlyRemoveTypeImports": true,
            "allowNamespaces": true,
            "isTSX": true
          }
        ]
      ]
    }
  ]
}
