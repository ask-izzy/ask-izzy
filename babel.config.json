{
  "presets": [
    [
      "next/babel",
      {
        "preset-env": {
          "targets": {
            "browsers": "> 0.25%, not dead, not op_mini all, not op_mob >= 1"
          },
          "bugfixes": true,
          "useBuiltIns": "usage",
          "corejs": 3.22
        }
      }
    ],
    "@babel/preset-react"
  ],
  "plugins": [
    [
      "module-resolver",
      {
        "alias": {
          "@": "."
        },
        "extensions": [
          ".js",
          ".jsx",
          ".ts",
          ".tsx",
          ".json"
        ]
      }
    ]
  ],
  "overrides": [
    {
      "test": [
        "**/*.js",
        "**/*.jsx"
      ],
      "presets": [
        "@babel/preset-flow"
      ]
    }
  ]
}
