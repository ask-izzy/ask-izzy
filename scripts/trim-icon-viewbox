#!/usr/bin/env node
/*
 * Works out the tightest viewBox for one or more icons in src/icons (so there
 * is no empty space on any side) and records it in the viewBoxOverrides map in
 * scripts/iconify, so it survives the icons being regenerated. The generated
 * icon file is updated too so the change takes effect straight away.
 *
 * Usage:
 *   ./scripts/trim-icon-viewbox Tick [Search ...]
 *   ./scripts/trim-icon-viewbox src/icons/Tick.ts
 *   ./scripts/trim-icon-viewbox --dry-run Tick   # just print the result
 *
 * Ideally we'd probably update the icons in https://github.com/ask-izzy/designs/
 * but nothing else uses them and it's quicker and easier to add an override here.
 * Eventually we'll move them into this repo anyway at which point we can update
 * the icon sources directly.
 */

const path = require("path");
const { readFileSync, writeFileSync, existsSync } = require("fs");
const { chromium } = require("@playwright/test");

const repoRoot = path.resolve(__dirname, "..");
const iconsDir = path.join(repoRoot, "src/icons");
const iconifyPath = path.join(repoRoot, "scripts/iconify");

// Longest side of the rendered icon in pixels. Higher = more precise bounds.
const RENDER_SIZE = 4096;

const args = process.argv.slice(2);
const dryRun = args.includes("--dry-run");
const iconArgs = args.filter(arg => arg !== "--dry-run");

if (!iconArgs.length) {
    console.log("Usage: ./scripts/trim-icon-viewbox [--dry-run] <icon name or path>...");
    process.exit(1);
}

function resolveIcon(arg) {
    const className = path.basename(arg).replace(/\.tsx?$/, "");
    const file = path.join(iconsDir, `${className}.ts`);
    if (!existsSync(file)) {
        throw new Error(`No icon found at ${path.relative(repoRoot, file)}`);
    }
    return { className, file };
}

const svgContentRegex = /(svgContent: string = `)([\s\S]*?)(`;)/;

function extractSvg(source, file) {
    const match = source.match(svgContentRegex);
    if (!match) {
        throw new Error(`Couldn't find svgContent in ${file}`);
    }
    // Resolve the template expressions in the markup so the browser gets
    // plain svg. The viewBox one keeps its default, the rest (class names,
    // optional fill colours etc) are dropped.
    return stripTemplateExpressions(
        match[2].replace(/\$\{this\.props\.viewBox \|\| "([^"]*)"\}/g, "$1")
    ).trim();
}

// Removes every ${...} from a template literal body, coping with nested
// template literals and braces.
function stripTemplateExpressions(str) {
    let out = "";
    let i = 0;
    while (i < str.length) {
        if (str[i] === "$" && str[i + 1] === "{") {
            let depth = 1;
            i += 2;
            while (i < str.length && depth) {
                if (str[i] === "{") depth++;
                else if (str[i] === "}") depth--;
                i++;
            }
        } else {
            out += str[i++];
        }
    }
    return out;
}

// Runs in the browser. Returns the painted bounds in viewBox units.
async function measure({ svgMarkup, renderSize }) {
    // Parse as HTML since that's how the icons get rendered in the app (it's
    // more forgiving than XML, eg of duplicate attributes or "viewbox").
    const container = document.createElement("div");
    container.innerHTML = svgMarkup;
    const svg = container.querySelector("svg");
    if (!svg) {
        throw new Error("Icon markup contains no svg");
    }
    const viewBoxAttr = svg.getAttribute("viewBox");
    if (!viewBoxAttr) {
        throw new Error("Icon has no viewBox");
    }
    const [vbX, vbY, vbW, vbH] = viewBoxAttr.trim().split(/[\s,]+/).map(Number);

    const scale = renderSize / Math.max(vbW, vbH);
    const width = Math.ceil(vbW * scale);
    const height = Math.ceil(vbH * scale);
    svg.setAttribute("width", String(width));
    svg.setAttribute("height", String(height));
    svg.setAttribute("preserveAspectRatio", "none");

    const blob = new Blob(
        [new XMLSerializer().serializeToString(svg)],
        { type: "image/svg+xml" },
    );
    const url = URL.createObjectURL(blob);
    const img = new Image();
    await new Promise((resolve, reject) => {
        img.onload = resolve;
        img.onerror = () => reject(new Error("Failed to render icon"));
        img.src = url;
    });

    const canvas = document.createElement("canvas");
    canvas.width = width;
    canvas.height = height;
    const ctx = canvas.getContext("2d");
    ctx.drawImage(img, 0, 0, width, height);
    const { data } = ctx.getImageData(0, 0, width, height);

    let minX = Infinity, minY = Infinity, maxX = -1, maxY = -1;
    for (let y = 0; y < height; y++) {
        for (let x = 0; x < width; x++) {
            if (data[(y * width + x) * 4 + 3] > 0) {
                if (x < minX) minX = x;
                if (x > maxX) maxX = x;
                if (y < minY) minY = y;
                if (y > maxY) maxY = y;
            }
        }
    }
    if (maxX < 0) {
        return { original: viewBoxAttr, bounds: null };
    }

    const scaleX = width / vbW;
    const scaleY = height / vbH;
    return {
        original: viewBoxAttr,
        bounds: {
            left: vbX + minX / scaleX,
            top: vbY + minY / scaleY,
            right: vbX + (maxX + 1) / scaleX,
            bottom: vbY + (maxY + 1) / scaleY,
        },
        // Size of one pixel in viewBox units
        precision: 1 / Math.min(scaleX, scaleY),
    };
}

function formatNumber(num) {
    return String(Number(num.toFixed(6)));
}

function toViewBox({ original, bounds, precision }) {
    const [vbX, vbY, vbW, vbH] = original.trim().split(/[\s,]+/).map(Number);
    // Round outwards so nothing gets clipped, but never past the original.
    const decimals = Math.max(0, Math.ceil(-Math.log10(precision)));
    const factor = 10 ** decimals;
    const left = Math.max(vbX, Math.floor(bounds.left * factor) / factor);
    const top = Math.max(vbY, Math.floor(bounds.top * factor) / factor);
    const right = Math.min(vbX + vbW, Math.ceil(bounds.right * factor) / factor);
    const bottom = Math.min(vbY + vbH, Math.ceil(bounds.bottom * factor) / factor);
    return [left, top, right - left, bottom - top].map(formatNumber).join(" ");
}

const overridesRegex = /(const viewBoxOverrides = )(\{[\s\S]*?\n\})(;)/;

function updateIconifyMap(newEntries) {
    const source = readFileSync(iconifyPath, "utf8");
    const overrides = { ...readOverrides(), ...newEntries };
    const sorted = Object.keys(overrides).sort().map(key =>
        `    ${JSON.stringify(key)}: ${JSON.stringify(overrides[key])},`
    );
    // Keep it valid JSON so it can be parsed back next time (no trailing comma).
    const body = sorted.length ?
        `{\n${sorted.join("\n").replace(/,$/, "")}\n}`
        : "{\n}";
    writeFileSync(
        iconifyPath,
        source.replace(overridesRegex, `$1${body}$3`),
        "utf8",
    );
}

function updateIconFile(file, source, viewBox) {
    const updated = source.replace(svgContentRegex, (match, start, svg, end) =>
        start +
        svg.replace(
            /(<svg\b[^>]*?\s)viewBox="(?:\$\{this\.props\.viewBox \|\| "[^"]*"\}|[^"]*)"/i,
            `$1viewBox="\${this.props.viewBox || "${viewBox}"}"`,
        ) +
        end
    );
    writeFileSync(file, updated, "utf8");
}

function readOverrides() {
    const match = readFileSync(iconifyPath, "utf8").match(overridesRegex);
    if (!match) {
        throw new Error("Couldn't find viewBoxOverrides map in scripts/iconify");
    }
    return JSON.parse(match[2]);
}

async function main() {
    const icons = iconArgs.map(resolveIcon);
    const existingOverrides = readOverrides();
    const browser = await chromium.launch();
    const newEntries = {};
    let failed = false;
    try {
        const page = await browser.newPage();
        for (const { className, file } of icons) {
            const source = readFileSync(file, "utf8");
            let result;
            try {
                result = await page.evaluate(measure, {
                    svgMarkup: extractSvg(source, file),
                    renderSize: RENDER_SIZE,
                });
            } catch (error) {
                console.error(`${className}: ${error.message.split("\n")[0]}`);
                failed = true;
                continue;
            }
            // Re-measuring an already trimmed icon would nibble a little more
            // off each time due to rounding, so leave it be.
            if (existingOverrides[className] === result.original) {
                console.log(`${className}: already trimmed to "${result.original}"`);
                continue;
            }
            if (!result.bounds) {
                console.error(`${className}: nothing is drawn, skipping`);
                failed = true;
                continue;
            }
            const viewBox = toViewBox(result);
            console.log(`${className}: "${result.original}" -> "${viewBox}"`);
            newEntries[className] = viewBox;
            if (!dryRun) {
                updateIconFile(file, source, viewBox);
            }
        }
    } finally {
        await browser.close();
    }
    if (!dryRun && Object.keys(newEntries).length) {
        updateIconifyMap(newEntries);
    }
    if (failed) {
        process.exitCode = 1;
    }
}

main().catch(error => {
    console.error(error.message);
    process.exit(1);
});
